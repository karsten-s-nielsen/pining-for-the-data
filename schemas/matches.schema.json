{
  "$defs": {
    "ArtifactMeta": {
      "description": "Content identity of one stored artifact object: the bytes as stored in S3 (ADR 0013).",
      "properties": {
        "sha256": {
          "description": "Lowercase hex SHA-256 of the stored bytes",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "description": "Size of the stored object in bytes",
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "_SourceMeta": {
      "description": "Provenance metadata for an upstream data source.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        },
        "licence": {
          "default": "",
          "title": "Licence",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upstream VCS commit the redistributed bytes were fetched from (git SHA-1).",
          "title": "Revision"
        }
      },
      "required": [
        "name"
      ],
      "title": "_SourceMeta",
      "type": "object"
    }
  },
  "$id": "urn:pining-for-the-data:schema:matches:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Canonical shape of a single entry in `{provider}/matches.json`. Spec \u00a74.1.",
  "properties": {
    "id": {
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of artifact-name to exact filename. Keys form the API allowlist; each key MUST match the path-param regex.",
      "title": "Artifacts",
      "type": "object"
    },
    "visibility": {
      "pattern": "^(public|private)$",
      "title": "Visibility",
      "type": "string"
    },
    "updated_at": {
      "description": "ISO 8601 UTC timestamp",
      "title": "Updated At",
      "type": "string"
    },
    "date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date"
    },
    "home": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Home"
    },
    "away": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Away"
    },
    "provenance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/_SourceMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "format_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Artifact-format generation. Absent = legacy layout; 2 = canonical Parquet/zstd set.",
      "title": "Format Version"
    },
    "competition_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider's competition id, verbatim",
      "title": "Competition Id"
    },
    "competition_name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider's competition name",
      "title": "Competition Name"
    },
    "season_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider's season id, verbatim; absent when the source gives no season id",
      "title": "Season Id"
    },
    "season_name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider's season value, verbatim",
      "title": "Season Name"
    },
    "artifact_meta": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactMeta"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per-artifact content identity of the stored objects. Keys equal the `artifacts` keys.",
      "title": "Artifact Meta"
    }
  },
  "required": [
    "id",
    "artifacts",
    "visibility",
    "updated_at"
  ],
  "title": "MatchEntry",
  "type": "object"
}
